---
import BaseLayout from "../layouts/Layout.astro";
---

<BaseLayout title="Inicio | Yanpol Silva">

<section id="habilidades" class="py-5">
  <div class="container">
    <h2 class="h2_hab">Habilidades</h2>
    <div class="habilidades-container">
      <div class="skill-item">
        <p>HTML5</p>
        <div class="progress" role="progressbar" aria-label="HTML5" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar bg-primary" style="width: 45%">45%</div>
        </div>
      </div>
      <div class="skill-item">
        <p>CSS3</p>
        <div class="progress" role="progressbar" aria-label="CSS3" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar bg-success" style="width: 50%">50%</div>
        </div>
      </div>
      <div class="skill-item">
        <p>JavaScript</p>
        <div class="progress" role="progressbar" aria-label="JavaScript" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar bg-warning" style="width: 65%">65%</div>
        </div>
      </div>
      <div class="skill-item">
        <p>Git y GitHub</p>
        <div class="progress" role="progressbar" aria-label="Git y GitHub" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar bg-info" style="width: 30%">30%</div>
        </div>
      </div>
    </div>
  </div>
</section>
</BaseLayout>