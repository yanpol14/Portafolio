</header>

<section id="proyectos" class="py-5 bg-light">
    <div class="container">
        <h2 class="h2_proyec">Proyectos</h2>
    <div class="row row-cols-1 row-cols-md-2 g-4 justify-content-center">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="/img/proyecto1.png" class="card-img-top" alt="Captura del Proyecto 1" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Landing Page de Panadería</h5>
                    <p class="card-text">Diseño simple y visualmente atractivo para una panadería local, optimizado para una excelente experiencia de usuario.</p>
                <div class="mt-auto text-center">
                    <a href="#" class="btn btn-dark mt-2 me-2">Ver Demo</a>
                    <a href="#" class="btn btn-outline-dark mt-2">Código Fuente</a>
                </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="img/proyecto_cosmetologia.png" class="card-img-top" alt="Captura del Proyecto 2" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Página web de un salón de belleza</h5>
                    <p class="card-text">Un modelo de sitio web que destaca los servicios y la imagen de una microempresa: "Yudit Salon".</p>
                    <div class="mt-auto text-center">
                        <a href="https://cosmetologia-yudit.vercel.app/index.html#" class="btn btn-dark mt-2 me-2">Ver Demo</a>
                        <a href="https://github.com/RickCrispin/YuditSalon" class="btn btn-outline-dark mt-2">Código Fuente</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="img/Captura de pantalla 2025-09-08 203213.png" class="card-img-top" alt="Captura del Proyecto 2" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Software de la barbera OPEN-BARBER</h5>
                    <p class="card-text">Un modelo de software con inicio de sesion, registro de usuarios, historial de venta, generador de citas y de venta de sevcios un modelo que es facil de entender y comprender por los usuarios.
                    </p>
                    <div class="mt-auto text-center">
                        <a href="#" class="btn btn-dark mt-2 me-2">Ver Demo</a>
                        <a href="https://github.com/RickCrispin/YuditSalon" class="btn btn-outline-dark mt-2">Código Fuente</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</section>

<footer class="text-center py-4 text-white">
