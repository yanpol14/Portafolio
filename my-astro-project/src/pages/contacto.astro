---
import BaseLayout from "../layouts/Layout.astro";
---

<BaseLayout title="Inicio | Yanpol Silva">
  <main>
    <section id="contacto" class="py-5 bg-light">
      <div class="container">
        <h2 class="text-center mb-5">Contacto</h2>
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <form id="formulario-contacto" class="p-4 rounded shadow-sm">
              <div class="mb-3">
                <label for="nombre" class="form-label">Nombre:</label>
                <input type="text" id="nombre" name="nombre" class="form-control" required />
              </div>
              <div class="mb-3">
                <label for="correo" class="form-label">Correo electrónico:</label>
                <input type="email" id="correo" name="correo" class="form-control" required />
              </div>
              <div class="mb-3">
                <label for="mensaje" class="form-label">Mensaje:</label>
                <textarea id="mensaje" name="mensaje" class="form-control" rows="5" required></textarea>
              </div>
              <div class="text-center">
                <button type="submit" class="btn btn-primary btn-lg">Enviar Mensaje</button>
              </div>
            </form>
            <div class="social-links text-center mt-4">
              <a href="https://github.com/dashboard" target="_blank" class="mx-2"><i class="fab fa-github"></i></a>
              <a href="https://linkedin.com/comm/mynetwork/discovery-see-all?usecase=PEOPLE_FOLLOWS&followMember=yanpol-silva-crispin-a02086335" target="_blank" class="mx-2"><i class="fab fa-linkedin-in"></i></a>
              <a href="#" target="_blank" class="mx-2"><i class="fab fa-twitter"></i></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>