---
import BaseLayout from "../layouts/Layout.astro";
import "../styles/estilos.css";
---

<BaseLayout title="Inicio | Yanpol Silva">

<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="#inicio">Yanpol Silva</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="index.html">Inicio</a>
                </li>
                <li class="nav-item">
                <a class="nav-link" href="index.html">Sobre mí</a>
                </li>
                <li class="nav-item">
                <a class="nav-link" href="proyect.html">Proyectos</a>
                </li>
                <li class="nav-item">
                <a class="nav-link" href="habilidades.html">Habilidades</a>
                </li>
                <li class="nav-item">
                <a class="nav-link" href="#">Contacto</a>
                </li>
            </ul>
            </div>
        </div>
        </nav>
    </header>
  
  <main>
    <section id="contacto" class="py-5 bg-light">
      <div class="container">
        <h2 class="text-center mb-5">Contacto</h2>
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <form id="formulario-contacto" class="p-4 rounded shadow-sm">
              <div class="mb-3">
                <label for="nombre" class="form-label">Nombre:</label>
                <input type="text" id="nombre" name="nombre" class="form-control" required />
              </div>
              <div class="mb-3">
                <label for="correo" class="form-label">Correo electrónico:</label>
                <input type="email" id="correo" name="correo" class="form-control" required />
              </div>
              <div class="mb-3">
                <label for="mensaje" class="form-label">Mensaje:</label>
                <textarea id="mensaje" name="mensaje" class="form-control" rows="5" required></textarea>
              </div>
              <div class="text-center">
                <button type="submit" class="btn btn-primary btn-lg">Enviar Mensaje</button>
              </div>
            </form>
            <div class="social-links text-center mt-4">
              <a href="https://github.com/dashboard" target="_blank" class="mx-2"><i class="fab fa-github"></i></a>
              <a href="#" target="_blank" class="mx-2"><i class="fab fa-linkedin-in"></i></a>
              <a href="#" target="_blank" class="mx-2"><i class="fab fa-twitter"></i></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

    <footer class="text-center py-4 text-white">
        <div class="container">
            <p class="mb-0">&copy; 2025 Yanpol Silva. Todos los derechos reservados.</p>
        </div>
    </footer>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/script.js"></script>